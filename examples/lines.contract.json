{
  "title": "Lines are net plus tax and add up to the total",
  "integerDigits": 4,
  "scale": 2,
  "fields": [
    "total"
  ],
  "lists": {
    "lines": {
      "maxItems": 4,
      "fields": [
        "net",
        "tax",
        "amount"
      ]
    }
  },
  "constraints": [
    "lines.amount = lines.net + lines.tax",
    "sum(lines.amount) = total"
  ]
}
